# Symbio environment configuration
# Copy this file to .env and fill in your own values.
# .env is gitignored and never committed.

# Core identity/model (overrides config.json)
SYMBIO_MODEL_NAME=mlx-community/Qwen3-8B-4bit
SYMBIO_ASSISTANT_NAME=Caine
SYMBIO_USER_NAME=Huy

# Telegram gateway secrets
SYMBIO_TELEGRAM_TOKEN=
SYMBIO_TELEGRAM_ALLOWED_CHAT_IDS=

# Local-brain MCP fallback settings
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3.2
LOCAL_TEMPERATURE=0.2
LOCAL_MAX_TOKENS=2048

# Frontier model fallback
FRONTIER_PROVIDER=anthropic
FRONTIER_MODEL=claude-sonnet-5-20251001
FRONTIER_API_KEY=
FRONTIER_TEMPERATURE=0.2
FRONTIER_MAX_TOKENS=4096

# Learning loop
MEMORY_DB_PATH=memory.db
MISS_THRESHOLD=5
AUTO_FINETUNE=false
